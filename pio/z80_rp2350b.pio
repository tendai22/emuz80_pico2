.define IORQ_Pin 22
.define RD_Pin   20
.define WR_Pin   21
.define WAIT_Pin 16
.define D0_Pin   24

; SET pin 0 should be mapped to your LED GPIO

;
; PIO0:SM0 ... ram_read
;   IN: A0-A15(0), IN_COUNT: 16
;   OUT: D0-Pin(24), OUT_COUNT: 8(D0-D7)
;   MOV: D0-Pin(24), OUT_COUNT: 8
;   JMP_PIN: RD_Pin(21)
;   SET_BASE: 31 (debug pin)
;   GPIO: CS: 26, OE: 27;   : RD_Pin(16), count: 1
.program ram_read
.wrap_target
loop_1:
    wait 1 gpio IORQ_Pin ; wait for IORQ==High && RD==Low
    jmp pin loop_1
    ;nop [10]            ; 5 -- 10 delay is needed for DMA transfer
    in pins, 16         ; capture A0-A15
    push                ; 32 bit is specified in in-shift,
                        ; so explicit push is needed. 
    mov pindirs, ~null  ; D0-D7 as output
    pull
    out pins, 8         ; output DMA CH2 data to D0-D7
    wait 1 gpio RD_Pin
    mov pindirs, null
.wrap

;
; PIO0:SM1 ... ram_write_addr
;   IN: A0-A15(0), IN_COUNT: 16, autopush
;   MOV: D0-Pin(24), OUT_COUNT: 8
;
.program ram_write_addr
.wrap_target
loop_2:
    wait 1 gpio IORQ_Pin ; wait for IORQ==High && WR==Low
    jmp pin loop_2
    mov pindirs, null   ; D0-D7 as input
    in pins, 16
    push
    wait 1 gpio WR_Pin
.wrap

;
; PIO0:SM2: ram_write_data
;   IN:  D0_Pin(24), count: 8, no-autopush
.program ram_write_data
.wrap_target
loop_3:
    wait 1 gpio IORQ_Pin
    jmp pin loop_3
    wait 1 gpio WR_Pin  ; wait for WR upper edge
    in pins, 8
    push
.wrap

;
; PIO1:SM2 ... two/one phase clock generator(program clockgen)
;
; SET: BASE: 40(CLK_Pin, inverted), 41(INT_Pin, inverted)
.program clockgen
.wrap_target
    ; outputs are inverted, so 0 means High, 1 means Low
    set pins, 1  ; Turn LED on
    set pins, 0  ; Turn LED off
; revive the following two lines if 2-phase clock feature we use
    ;set pins, 2
    ;set pins, 3
.wrap             ; Blink forever!

;
;

;
; PIO1:SM3: iorq_wait
;   SET: WAIT_Pin(16), count: 1
.program iorq_wait
    set pins, 1
.wrap_target
    wait 0 gpio IORQ_Pin     ; IORQ_Pin(22)
    set pins, 0         ; WAIT_PIn(19) Low
    pull                ; wait for MainCPU work done
    set pins, 1         ; WAIT_Pin(19) High
    wait 1 gpio IORQ_Pin     ; IORQ_Pin(22)
    push
.wrap

% c-sdk {
